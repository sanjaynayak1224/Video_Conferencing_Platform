# Server Configuration
PORT=8080

# MongoDB Connection (Atlas cluster or local daemon)
MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/apnavideocall

# JWT signing secret — use a long random string in production
JWT_SECRET=your_jwt_signing_secret_key_here

# Frontend origin for CORS (default: allow all in development)
CORS_ORIGIN=http://localhost:5173
